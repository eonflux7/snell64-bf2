# [BUILD] The native plugin DLLs' ABI invariants, checked after every link of their CMake
# targets (Code/RendDX9Abi, Code/SwiffPlayerAbi, Code/BF2AudioAbi). The same checks as STEP 4 of
# renddx9.cmd, textureatlasbuilder.cmd, swiffplayer.cmd and bf2audio.cmd: a drifted shape loads and then
# misbehaves instead of failing, so each one stops the build and removes the DLL.
#   cmake -DPLUGIN=renddx9|textureatlasbuilder|swiffplayer|bf2audio -DDUMPBIN=<dumpbin.exe> -DDLL=<dll>
#         -DARCH=x64|x86 -DFALLBACK=ON|OFF -DABI=<Code/RendDX9Abi> -DWORK=<dir>
#         -P Code/Build/plugin_abicheck.cmake
# FALLBACK (no DirectX SDK), ABI and D3DX_DLL (the D3DX the image links; default d3dx9_25.dll, the
# scripts' retail-parity builds) are read by the D3DX users, renddx9 and textureatlasbuilder.
foreach(_v PLUGIN DUMPBIN DLL ARCH WORK)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "plugin_abicheck.cmake: -D${_v} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
if(NOT DEFINED D3DX_DLL)
    set(D3DX_DLL d3dx9_25.dll)
endif()

function(_dumpbin out)
    execute_process(COMMAND "${DUMPBIN}" /nologo ${ARGN} "${DLL}"
        OUTPUT_VARIABLE _text RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "${PLUGIN} ABI: dumpbin ${ARGN} failed (${_rc})")
    endif()
    string(REPLACE "/" "_" _name "${ARGN}")
    string(REPLACE ":" "_" _name "${_name}")
    file(WRITE "${WORK}/${_name}.txt" "${_text}")
    set(${out} "${_text}" PARENT_SCOPE)
endfunction()

set(_bad 0)
macro(_fail msg)
    message(SEND_ERROR "${PLUGIN} ABI: ${msg}")
    math(EXPR _bad "${_bad} + 1")
endmacro()
macro(_require text needle msg)
    string(FIND "${${text}}" "${needle}" _at)
    if(_at EQUAL -1)
        _fail("${msg}")
    endif()
endmacro()
macro(_forbid text needle msg)
    string(FIND "${${text}}" "${needle}" _at)
    if(NOT _at EQUAL -1)
        _fail("${msg}")
    endif()
endmacro()
# An export is a dumpbin line "<ordinal> <hint> <rva> <name>", optionally followed by " = <internal
# name>": match the whole name, so deinitDll cannot satisfy initDll. Returns the ordinal column.
function(_export_line out name)
    string(REGEX REPLACE "([][.*+?^$()|\\\\])" "\\\\\\1" _escaped "${name}")
    string(REGEX MATCH "(^|\n)[ \t]*([0-9]+)[ \t]+[0-9A-Fa-f]+[ \t]+[0-9A-Fa-f]+[ \t]+${_escaped}([ \t]+=[ \t][^\r\n]*)?[ \t]*(\r?\n|$)" _line "${_exports}")
    if(_line)
        set(${out} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    else()
        set(${out} "" PARENT_SCOPE)
    endif()
endfunction()
macro(_require_export name)
    _export_line(_ord "${name}")
    if(_ord STREQUAL "")
        _fail("export ${name} MISSING")
    endif()
endmacro()
# The native ABI: no retail heap or CRT, the host's shared native CRT instead.
macro(_require_native_crt)
    _forbid(_deps_lower "memory.dll" "retail heap Memory.dll imported")
    _forbid(_deps_lower "msvcr71.dll" "retail CRT msvcr71.dll imported")
    _forbid(_deps_lower "msvcp71.dll" "retail CRT msvcp71.dll imported")
    _require(_deps_lower "vcruntime140.dll" "native shared VCRUNTIME140.dll MISSING")
endmacro()
macro(_require_shared_heap)
    string(REGEX MATCH "api-ms-win-crt-heap-|ucrtbase\\.dll" _heap "${_deps_lower}")
    if(NOT _heap)
        _fail("native shared CRT heap MISSING")
    endif()
endmacro()
# The D3DX the build chose (retail: d3dx9_25.dll; the Ninja build: d3dx9_43.dll), delay-loaded.
macro(_require_d3dx25)
    _require(_deps_lower "${D3DX_DLL}" "${D3DX_DLL} MISSING - the image must link the D3DX the build chose")
    _require(_deps_lower "delay load dependencies" "${D3DX_DLL} NOT delay-loaded")
    if(FALLBACK)
        # The fallback's import names must be the DLL's plain export names: a decorated name links
        # and then fails to load with ERROR_PROC_NOT_FOUND.
        _dumpbin(_d3dx /imports:${D3DX_DLL})
        string(REGEX MATCH "D3DX[A-Za-z0-9_]*@" _decorated "${_d3dx}")
        if(_decorated)
            _fail("${D3DX_DLL} import names DECORATED (${_decorated}...)")
        endif()
    endif()
endmacro()

_dumpbin(_exports /exports)
_dumpbin(_deps /dependents)
string(TOLOWER "${_deps}" _deps_lower)

if(PLUGIN STREQUAL "renddx9")
    # The host resolves both entry points by name.
    _require_export(initDll)
    _require_export(deinitDll)
    _require_native_crt()
    _require_shared_heap()
    _require_d3dx25()
    # The shipped image imports exactly TextureAtlasBuilder.dll's two creates, by name.
    _dumpbin(_tab /imports:TextureAtlasBuilder.dll)
    if(ARCH STREQUAL "x64")
        _require(_tab "?create@ITextureAtlas@textureatlas@@SAPEAV12@PEAUIDirect3DDevice9@@@Z" "TextureAtlasBuilder.dll ITextureAtlas::create MISSING")
        _require(_tab "?create@ITextureAtlasConfiguration@textureatlas@@SAPEAV12@XZ" "TextureAtlasBuilder.dll ITextureAtlasConfiguration::create MISSING")
    else()
        _require(_tab "?create@ITextureAtlas@textureatlas@@SIPAV12@PAUIDirect3DDevice9@@@Z" "TextureAtlasBuilder.dll ITextureAtlas::create MISSING")
        _require(_tab "?create@ITextureAtlasConfiguration@textureatlas@@SIPAV12@XZ" "TextureAtlasBuilder.dll ITextureAtlasConfiguration::create MISSING")
    endif()

elseif(PLUGIN STREQUAL "textureatlasbuilder")
    if(NOT DEFINED ABI)
        message(FATAL_ERROR "plugin_abicheck.cmake: -DABI is required for textureatlasbuilder")
    endif()
    _require(_exports "12 number of functions" "not exactly twelve exported functions - the shipped image has twelve")
    if(ARCH STREQUAL "x64")
        # The two creates RendDX9 imports by name (RendDX9Abi/TextureAtlasBuilder_x64.def).
        file(STRINGS "${ABI}/TextureAtlasBuilder_x64.def" _def)
        foreach(_line IN LISTS _def)
            string(STRIP "${_line}" _line)
            if(_line MATCHES "^(LIBRARY|EXPORTS|;)" OR _line STREQUAL "")
                continue()
            endif()
            string(REGEX REPLACE "[ \t].*$" "" _name "${_line}")
            _export_line(_ord "${_name}")
            if(_ord STREQUAL "")
                _fail("export ${_name} MISSING - RendDX9 x64 imports it by name")
            endif()
        endforeach()
    else()
        # Name AND ordinal of each EXPORTS line of the .def the link pinned them with.
        file(STRINGS "${ABI}/TextureAtlasBuilderExports.def" _def)
        set(_expected 0)
        foreach(_line IN LISTS _def)
            if(_line MATCHES "^[ \t]*([^; \t]+)[ \t]+@([0-9]+)")
                set(_name "${CMAKE_MATCH_1}")
                set(_want "${CMAKE_MATCH_2}")
                math(EXPR _expected "${_expected} + 1")
                _export_line(_ord "${_name}")
                if(NOT _ord STREQUAL _want)
                    _fail("export ordinal ${_want} ${_name} MISSING")
                endif()
            endif()
        endforeach()
        if(NOT _expected EQUAL 12)
            _fail("read ${_expected} names from TextureAtlasBuilderExports.def, expected 12")
        endif()
    endif()
    _require_d3dx25()
    _forbid(_deps_lower "d3d9.dll" "d3d9.dll UNEXPECTED - the shipped image takes the device through create()")
    _forbid(_deps_lower "user32.dll" "USER32.dll UNEXPECTED - DxErr9's DXTrace should have been discarded by /OPT:REF")
    foreach(_crt "vcruntime" "api-ms-win-crt-" "ucrtbase.dll" "msvcp" "msvcr71.dll")
        _forbid(_deps_lower "${_crt}" "a shared CRT (${_crt}) UNEXPECTED - this DLL links the CRT statically")
    endforeach()
    _forbid(_deps_lower "memory.dll" "Memory.dll UNEXPECTED in the native atlas")
    _dumpbin(_imports /imports)
    foreach(_fn D3DXCreateTexture D3DXCreateTextureFromFileExA D3DXGetImageInfoFromFileA
                D3DXLoadSurfaceFromSurface D3DXSaveTextureToFileA)
        if(NOT _imports MATCHES "[ \t]${_fn}[ \t]*(\r?\n|$)")
            _fail("${D3DX_DLL} ${_fn} import MISSING")
        endif()
    endforeach()

elseif(PLUGIN STREQUAL "swiffplayer")
    _require_export(initDll)
    _require_export(deinitDll)
    _require_native_crt()
    _require_shared_heap()
    _dumpbin(_imports /imports)
    foreach(_fn "?bf_malloc@memory@hfe@dice@@YAPAXIH@Z" "?bf_free@memory@hfe@dice@@YAXPAX@Z"
                "?addMemoryName@memory@hfe@dice@@YAHPBD@Z")
        _forbid(_imports "${_fn}" "engine heap function ${_fn} UNEXPECTED in the native ABI")
    endforeach()

elseif(PLUGIN STREQUAL "bf2audio")
    _require_export(getSoundEngine)
    _require_export(shutdownSoundEngine)
    _require(_deps_lower "dsound.dll" "DSOUND.dll MISSING (the device probe)")
    _forbid(_deps_lower "openal32.dll" "OpenAL32.dll linked statically - the shipped image loads it by name")
    _forbid(_deps_lower "bf2openal.dll" "BF2OpenAL.dll linked statically - the shipped image loads it by name")
    _require_native_crt()

else()
    message(FATAL_ERROR "plugin_abicheck.cmake: unknown PLUGIN \"${PLUGIN}\"")
endif()

if(NOT _bad EQUAL 0)
    file(REMOVE "${DLL}")
    message(FATAL_ERROR "${PLUGIN} ABI check FAILED (${_bad}); the DLL was removed so it cannot be staged")
endif()
message(STATUS "${PLUGIN} ABI check: OK")
